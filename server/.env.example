# Shared config for the ANR Saver backend (systemd EnvironmentFile).
# Copy to /opt/anrsaver/.env and fill in every secret. API_KEY must match
# lib/src/core/utils/api_config.dart in the app.

# Public HTTPS origin handled by Caddy/Nginx.
API_ORIGIN=https://api.ekalliptus.com

# Secret shared with the app (ApiConfig.ytdlpApiKey / cookieSyncApiKey).
# NEVER commit the real value.
API_KEY=<replace-with-strong-random-secret>

# Admin key for /premium/admin/* (order confirm, order list).
ADMIN_KEY=<replace-with-strong-random-secret>

# HMAC-SHA256 secret shared with the payment webhook relay.
WEBHOOK_SECRET=<replace-with-strong-random-secret>

# Static GoPay merchant QRIS payload (EMVCo) converted to dynamic per order.
STATIC_QRIS=<paste-static-qris-payload>

# Cobalt's cookies.json (mounted read-only into the container)
COOKIE_PATH=/opt/anrsaver/cookies.json

# Per-platform Netscape cookie files for yt-dlp (shared by both services)
COOKIE_DIR=/opt/anrsaver/cookies

# Where yt-dlp writes merged files before serving them
DOWNLOAD_DIR=/opt/anrsaver/downloads

# Optional public API origin; makes /files tunnel URLs absolute for remote clients
PUBLIC_BASE_URL=https://api.ekalliptus.com/ytdlp

# Docker container name for Cobalt (cookie_sync restarts it on cookie change)
COBALT_CONTAINER=cobalt
