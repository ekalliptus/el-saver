{
    auto_https disable_redirects
    # Trust Cloudflare edge IPs so client_ip = the real visitor IP (from
    # CF-Connecting-IP), not the CF edge — this is what uvicorn's per-IP
    # rate limiting sees via X-Forwarded-For.
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    }
}

https://api.ekalliptus.com {
    handle_path /ytdlp/* {
        reverse_proxy 127.0.0.1:9002
    }

    handle_path /cookie-sync/* {
        reverse_proxy 127.0.0.1:9005
    }

    handle {
        reverse_proxy 127.0.0.1:9000
    }
}

router.ekalliptus.com {
    encode zstd gzip

    # Absorb abusive oversized payloads before they reach the app
    request_body {
        max_size 50MB
    }

    # Static assets caching (_next/static, public assets)
    @static {
        path /_next/static/* /favicon.svg /material-symbols* /providers/*
    }
    header @static Cache-Control public, max-age=31536000, immutable

    # HTML and dynamic API: no-cache
    @dynamic {
        not path /_next/static/* /favicon.svg /material-symbols* /providers/*
    }
    header @dynamic Cache-Control no-cache, no-store, must-revalidate

    reverse_proxy 127.0.0.1:20128 {
        # Streaming flush for LLM SSE
        flush_interval -1
    }
}
